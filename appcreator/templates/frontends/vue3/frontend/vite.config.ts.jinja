import { realpathSync } from 'node:fs'
import { defineConfig, loadEnv, searchForWorkspaceRoot } from 'vite'
import vue from '@vitejs/plugin-vue'
import tailwindcss from '@tailwindcss/vite'
import { fileURLToPath, URL } from 'node:url'

export default defineConfig(({ mode }) => {
  // Ports come from the .env in the project root (written by appcreator) or the environment.
  const env = loadEnv(mode, fileURLToPath(new URL('..', import.meta.url)), '')
  const port = Number(env.FRONTEND_PORT) || {{ ports.frontend }}
  // Backend the dev proxy forwards /api to; override (e.g. an agent backend on {{ ports.agent_start }}+) with VITE_PROXY_TARGET.
  const proxyTarget = env.VITE_PROXY_TARGET || `http://localhost:${env.BACKEND_PORT || {{ ports.backend }}}`

  return {
    plugins: [vue(), tailwindcss()],
    resolve: {
      alias: {
        '@': fileURLToPath(new URL('./src', import.meta.url)),
      },
    },
    server: {
      port,
      // Fail instead of silently moving to another port: proxy and CORS are tied to this one.
      strictPort: true,
      // In a git worktree `node_modules` can be a symlink to the main checkout; allow its real path so
      // assets such as the Inter font load.
      fs: {
        allow: [searchForWorkspaceRoot(process.cwd()), realpathSync(fileURLToPath(new URL('./node_modules', import.meta.url)))],
      },
      proxy: {
        '/api': {
          target: proxyTarget,
          changeOrigin: true,
          secure: false,
          ws: true,
        },
      },
    },
  }
})
