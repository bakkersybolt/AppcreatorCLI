{
  "name": "{{ app_slug }}-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "generate:types": "openapi-typescript http://localhost:${BACKEND_PORT:-{{ ports.backend }}}/openapi.json --output src/types/schema.d.ts",
    "test": "vitest run",
    "lint": "eslint . --fix && vue-tsc --noEmit -p tsconfig.vitest.json && prettier --check src/",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^10.11.1",
    "axios": "^1.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.0",
    "pinia": "^2.1.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-oxlint": "~1.88.0",
    "eslint-plugin-vue": "^10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.0.0",
    "oxlint": "~1.88.0",
    "prettier": "^3.2.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^2.2.12"
  }
