ENVIRONMENT=development
DEBUG=True
{% if database == "postgres" %}
# De poort hieronder moet gelijk zijn aan POSTGRES_PORT in de .env in de projectroot
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/{{ app_slug }}_db
{% elif database == "sqlite" %}
DATABASE_URL=sqlite+aiosqlite:///./app.db
{% endif %}
