ENVIRONMENT=development
DEBUG=True
{% if database == "postgres" %}
# De poort hieronder moet gelijk zijn aan POSTGRES_PORT in de .env in de projectroot
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:{{ ports.postgres }}/{{ app_slug }}_db
{% elif database == "sqlite" %}
DATABASE_URL=sqlite+aiosqlite:///./app.db
{% endif %}
{% if frontend == "vue3" %}
# Origins die de API mogen aanroepen (JSON-lijst); standaard de Vite dev-server
CORS_ORIGINS=["http://localhost:{{ ports.frontend }}"]
{% endif %}
