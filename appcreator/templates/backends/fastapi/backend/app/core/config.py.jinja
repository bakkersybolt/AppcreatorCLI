from functools import lru_cache
from typing import Optional
from pydantic_settings import BaseSettings, SettingsConfigDict


class Settings(BaseSettings):
    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        extra="ignore",
    )

    APP_NAME: str = "{{ app_naam }}"
    API_V1_STR: str = "/api/v1"
    ENVIRONMENT: str = "development"
    DEBUG: bool = True
    # Origins that may call the API from a browser (the Vite dev server by default)
    CORS_ORIGINS: list[str] = [{% if frontend == "vue3" %}"http://localhost:{{ ports.frontend }}"{% endif %}]

    {% if database == "postgres" %}
    DATABASE_URL: str = "postgresql+asyncpg://postgres:postgrespassword@localhost:{{ ports.postgres }}/{{ app_slug }}_db"
    {% elif database == "sqlite" %}
    DATABASE_URL: str = "sqlite+aiosqlite:///./app.db"
    {% else %}
    DATABASE_URL: Optional[str] = None
    {% endif %}


@lru_cache
def get_settings() -> Settings:
    return Settings()


settings = get_settings()
