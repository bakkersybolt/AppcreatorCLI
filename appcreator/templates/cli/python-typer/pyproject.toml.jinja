[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ app_slug }}"
version = "0.1.0"
description = "{{ app_naam }} - CLI tool gegenereerd via AppCreator."
readme = "README.md"
requires-python = ">=3.9"
dependencies = [
    "typer>=0.9.0",
    "rich>=13.0.0",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
    "ruff>=0.6.0",
]

[project.scripts]
{{ app_slug }} = "{{ package_name }}.main:app"

[tool.ruff]
line-length = 110
# Matches requires-python, so pyupgrade (UP) never suggests syntax newer than the supported Python
target-version = "py39"
extend-exclude = [".venv"]

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "SIM", "ASYNC"]

[tool.ruff.lint.flake8-bugbear]
# Typer parameter markers are meant to be used as argument defaults
extend-immutable-calls = ["typer.Argument", "typer.Option"]

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]
