#!/usr/bin/env bash
# =============================================================================
# Zet de deploy-secrets van de huidige repo in GitHub. Eenmalig per repo,
# vanuit de repo-map:
#
#   SERVER_IP=<ip-van-de-server> bash scripts/setup-github-secrets.sh
#
# Het IP-adres staat bewust niet in deze repo.
# Vereist: GitHub CLI (`gh auth login`) en de deploysleutel ({{ features.hobbyserver.deploy_key }}).
# =============================================================================
set -euo pipefail

: "${SERVER_IP:?Geef het IP-adres van de server mee: SERVER_IP=<ip> bash scripts/setup-github-secrets.sh}"
DEPLOY_KEY="${DEPLOY_KEY:-{{ features.hobbyserver.deploy_key | replace("~", "$HOME") }}}"

command -v gh >/dev/null || { echo "Installeer eerst de GitHub CLI: brew install gh"; exit 1; }
[[ -f "$DEPLOY_KEY" ]] || { echo "Sleutel $DEPLOY_KEY niet gevonden"; exit 1; }

echo "Repo: $(gh repo view --json nameWithOwner -q .nameWithOwner)"

gh secret set DEPLOY_HOST --body "$SERVER_IP"
gh secret set DEPLOY_SSH_KEY < "$DEPLOY_KEY"
ssh-keyscan -t ed25519 "$SERVER_IP" 2>/dev/null | gh secret set DEPLOY_KNOWN_HOSTS

echo
echo "✅ Deploy-secrets ingesteld."
echo "Geheime app-waarden (optioneel) zet je met:"
echo "  gh secret set APP_SECRETS < geheimen.env     # regels KEY=waarde, bestand daarna verwijderen"
