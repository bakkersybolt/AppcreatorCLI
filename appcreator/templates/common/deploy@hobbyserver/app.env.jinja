# =============================================================================
# Instellingen van deze app voor de server. Dit is het ENIGE bestand dat je
# per app hoeft in te vullen. Staat gewoon in git (geen geheimen hier!).
# =============================================================================

# Korte naam, alleen kleine letters, cijfers en '-'. Wordt de map
# /opt/apps/<APP_NAME> op de server en het voorvoegsel van de containers.
APP_NAME={{ features.hobbyserver.app_name }}

# Domein waarop de app bereikbaar wordt. Laat het A-record naar de server wijzen.
APP_DOMAIN={{ features.hobbyserver.domain }}

# Poort waarop de Python-backend luistert (in de container).
BACKEND_PORT=8000

# Database (naam/gebruiker; het wachtwoord maakt de server zelf aan)
POSTGRES_DB={{ features.hobbyserver.app_name | replace("-", "_") }}
POSTGRES_USER={{ features.hobbyserver.app_name | replace("-", "_") }}

# Overige NIET-geheime instellingen voor de backend
ENVIRONMENT=production
DEBUG=false
# Enkele aanhalingstekens: bash én Docker Compose lezen dit bestand
CORS_ORIGINS='["https://{{ features.hobbyserver.domain }}"]'
# Blijvende bestanden (uploads e.d.) schrijft de backend alleen onder /data (volume app-data)

# GEHEIME waarden (wachtwoorden, API-sleutels, tokens) horen NIET hier, maar in het
# GitHub-secret APP_SECRETS (regels KEY=waarde).
