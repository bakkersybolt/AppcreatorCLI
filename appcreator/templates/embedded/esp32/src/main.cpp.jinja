#include <Arduino.h>
#include <ArduinoJson.h>

#define LED_PIN 2

const unsigned long HEARTBEAT_INTERVAL_MS = 5000; // Elke 5 seconden heartbeat
const unsigned long BLINK_INTERVAL_MS = 1000;     // Elke seconde een korte LED-puls
const unsigned long BLINK_DURATION_MS = 50;

unsigned long lastHeartbeat = 0;
unsigned long lastBlink = 0;
bool ledOn = false;

void setup() {
    Serial.begin(115200);
    delay(1000);

    pinMode(LED_PIN, OUTPUT);
    digitalWrite(LED_PIN, LOW);

    Serial.println();
    Serial.println("======================================");
    Serial.println("🚀 {{ app_naam }} - ESP32 Firmware Gestart");
    Serial.println("Geconfigureerd via AppCreator CLI");
    Serial.println("======================================");
}

void loop() {
    unsigned long now = millis();

    // Knipper de LED als activiteitsindicator, zonder de loop te blokkeren
    if (!ledOn && now - lastBlink >= BLINK_INTERVAL_MS) {
        lastBlink = now;
        ledOn = true;
        digitalWrite(LED_PIN, HIGH);
    } else if (ledOn && now - lastBlink >= BLINK_DURATION_MS) {
        ledOn = false;
        digitalWrite(LED_PIN, LOW);
    }

    // Periodieke heartbeat op de Serial monitor
    if (now - lastHeartbeat >= HEARTBEAT_INTERVAL_MS) {
        lastHeartbeat = now;

        JsonDocument doc;
        doc["app"] = "{{ app_naam }}";
        doc["uptime_ms"] = now;
        doc["status"] = "online";
        doc["free_heap"] = ESP.getFreeHeap();

        serializeJson(doc, Serial);
        Serial.println();
    }
}
