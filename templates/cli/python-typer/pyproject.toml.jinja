[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[project]
name = "{{ app_slug }}"
version = "0.1.0"
description = "{{ app_naam }} - CLI tool gegenereerd via AppCreator."
readme = "README.md"
requires-python = ">=3.9"
dependencies = [
    "typer>=0.9.0",
    "rich>=13.0.0",
]

[project.scripts]
{{ app_slug }} = "{{ app_slug }}.main:app"
