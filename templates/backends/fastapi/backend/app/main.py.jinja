from contextlib import asynccontextmanager
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from app.core.config import settings
from app.api.v1.router import api_router
from app.db.base import Base
{% if database != "none" %}
from app.db.session import engine
{% if entiteiten %}
import app.models  # noqa: F401 - Zorgt dat Base.metadata alle entiteiten registreert
{% endif %}
{% endif %}


@asynccontextmanager
async def lifespan(app: FastAPI):
    # Startup logica
    {% if database != "none" %}
    async with engine.begin() as conn:
        await conn.run_sync(Base.metadata.create_all)
    {% endif %}
    yield
    # Shutdown logica
    {% if database != "none" %}
    await engine.dispose()
    {% endif %}


app = FastAPI(
    title=settings.APP_NAME,
    description="AI-Ready Backend gegenereerd via AppCreator CLI",
    version="0.1.0",
    lifespan=lifespan,
)

# CORS Middleware configuratie
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Koppel API v1 routes
app.include_router(api_router, prefix=settings.API_V1_STR)


@app.get("/", summary="Root Index")
async def root():
    return {
        "message": f"Welkom bij {settings.APP_NAME} API!",
        "docs": "/docs",
        "health": f"{settings.API_V1_STR}/health",
    }
